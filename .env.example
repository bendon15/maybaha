# Copy this file to .env and fill in real values.
# Never commit the real .env file.

# --- App ---
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.example

# --- CORS ---
# Comma-separated list of allowed origins. Use * only for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Weather provider ---
# If left blank, the app automatically falls back to the demo/mock weather
# provider and labels all weather data as DEMO DATA in the UI.
OPENWEATHERMAP_API_KEY=
WEATHER_PROVIDER=mock
# WEATHER_PROVIDER=openweathermap

# --- Flood provider ---
# No official real-time public API for Philippine flood incidents is wired
# up yet. Set FLOOD_PROVIDER=mock (default) until one is integrated. See
# services/flood/README.md for integration notes (DOST-Project NOAH, MMDA,
# LGU advisories, PAGASA flood forecasting/ FEWS).
FLOOD_PROVIDER=mock

# --- Routing provider ---
# Public OSRM demo server by default (no key required, rate-limited, for
# demo/dev only). Point to your own OSRM/GraphHopper/Valhalla instance in
# production.
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org

# --- Geocoding provider ---
GEOCODING_PROVIDER=nominatim
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=FloodRoutePH/1.0 (contact@example.com)

# --- Rate limiting ---
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
# Where rate-limit counters are written. Leave as a relative path for
# traditional hosting. On Vercel's container runtime this is set to an
# absolute /tmp path automatically by Dockerfile.vercel — no need to set
# it yourself there.
# RATE_LIMIT_CACHE_DIR=data/cache/ratelimit

# --- Logging ---
LOG_LEVEL=info
LOG_PATH=logs/app.log
# On Vercel's container runtime, Dockerfile.vercel overrides this to an
# absolute /tmp path automatically. Logs there don't persist between cold
# starts — view them with `vercel logs` instead of tailing a file.
